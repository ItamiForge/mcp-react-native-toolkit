{
    "name": "mcp-react-native-toolkit",
    "version": "1.0.0",
    "description": "MCP server providing AI agents with accurate, version-aware React Native and Expo documentation",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "mcp-rn-init": "./bin/mcp-rn-init"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "fetch-docs": "tsx scripts/fetch-docs.ts",
        "optimize-docs": "tsx scripts/optimize-docs.ts",
        "refresh-docs": "npm run fetch-docs && npm run optimize-docs",
        "setup": "./setup.sh"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "react-native",
        "expo",
        "react-navigation",
        "ai-agent",
        "copilot",
        "cursor",
        "claude",
        "documentation"
    ],
    "author": "ItamiForge",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ItamiForge/mcp-react-native-toolkit.git"
    },
    "bugs": {
        "url": "https://github.com/ItamiForge/mcp-react-native-toolkit/issues"
    },
    "homepage": "https://github.com/ItamiForge/mcp-react-native-toolkit#readme",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^0.6.0",
        "semver": "^7.5.4",
        "tar": "^7.5.2",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.11.0",
        "@types/semver": "^7.5.6",
        "@types/tar": "^6.1.13",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    }
}
